+@pytest.mark.parametrize('status_code', [408, 429, 500, 502, 503, 504])
+async def test_http_status_retries_then_primary_succeeds_without_fallback(tmp_path, status_code):
+    model = build(tmp_path, profile(fallback=profile('backup')))
+    model._max_transient_retries = 1
+    model._retry_base_seconds = 0
+    requests = []
+    def handler(request):
+        payload = json.loads(request.content)
+        requests.append(payload['model'])
+        return httpx.Response(status_code, json={'detail': '注入的模型故障'}) if len(requests) == 1 else response(payload)
+    try:
+        for candidate in (model, model._fallback):
+            await mock_client(candidate, handler)
+        result = await model([UserMsg('buyer', '挑选轻便背包')])
+        assert requests == ['primary', 'primary']
+        assert result.metadata['model_execution']['profile_id'] == 'primary'
+        assert not model._throttle._semaphore.locked()
+        assert not model._fallback_throttle._semaphore.locked()
+    finally:
+        await model.client.close()
+        await model._fallback.client.close()
+
+
+@pytest.mark.parametrize('status_code', [400, 401, 403, 404, 422])
+async def test_nontransient_http_status_raises_without_retry_or_fallback(tmp_path, status_code):
+    model = build(tmp_path, profile(fallback=profile('backup')))
+    model._max_transient_retries = 1
+    model._retry_base_seconds = 0
+    requests = []
+    def handler(request):
+        requests.append(json.loads(request.content)['model'])
+        return httpx.Response(status_code, json={'detail': '注入的模型故障'})
+    try:
+        for candidate in (model, model._fallback):
+            await mock_client(candidate, handler)
+        with pytest.raises(APIStatusError) as error:
+            await model([UserMsg('buyer', '挑选轻便背包')])
+        assert error.value.status_code == status_code
+        assert requests == ['primary']
+        assert not model._throttle._semaphore.locked()
+        assert not model._fallback_throttle._semaphore.locked()
+    finally:
+        await model.client.close()
+        await model._fallback.client.close()
+
